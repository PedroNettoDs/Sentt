# =====================================================================
# Sentt — variáveis de ambiente do backend NestJS
# Ver prompt-motor.md §8 para descrição completa de cada grupo.
# =====================================================================

# --- App ---
NODE_ENV=development
APP_PORT=3000

# --- Banco (MySQL 8 ou PostgreSQL) ---
# MYSQL_* são consumidas pelo container `mysql` do docker-compose.yml.
# DATABASE_URL é lida pelo Prisma — user/senha/base precisam bater com MYSQL_*.
MYSQL_DATABASE=motor
MYSQL_USER=motor
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DATABASE_URL="mysql://motor:senha@mysql:3306/motor"

# --- Redis (broker do BullMQ + cache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Evolution API (driver Baileys) ---
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=                          # API key para header 'apikey' (= AUTHENTICATION_API_KEY em docker/evolution/.env)
EVOLUTION_WEBHOOK_TOKEN=                    # token Bearer que Evolution envia nos webhooks
EVOLUTION_WEBHOOK_URL=http://backend:3000/api/v1/whatsapp/webhook

# --- PostgreSQL dedicado à Evolution API ---
# Consumido pelo compose para interpolar ${EVOLUTION_DB_*} no serviço evolution-db.
# Mesmos valores devem estar em docker/evolution/.env para o container da Evolution.
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=
EVOLUTION_DB_NAME=evolution

# --- Meta Cloud API ---
CLOUD_API_GRAPH_VERSION=v20.0
CLOUD_API_APP_SECRET=                       # App Secret do Meta App (HMAC de webhooks)
CLOUD_API_VERIFY_TOKEN=                     # token para handshake GET /webhook/cloud

# --- Criptografia de credenciais da Cloud API ---
# Obrigatório: chave de 32 bytes em base64.
# Gerar com:  openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# --- Horário comercial (global, usado pelo DispatchProcessor) ---
DEFAULT_TIMEZONE=America/Sao_Paulo
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=18
BUSINESS_WEEKDAYS=1,2,3,4,5                 # 0=Domingo, 1=Segunda, ... 6=Sábado

# --- BullMQ dashboard (opcional, Bull-Board em /admin/queues) ---
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=
