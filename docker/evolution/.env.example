# =============================================================================
# Evolution API — variáveis de ambiente
# Copie para docker/evolution/.env e preencha antes de subir o compose.
# AUTHENTICATION_API_KEY deve ser idêntica a EVOLUTION_API_KEY no .env raiz.
# =============================================================================

# --- Chave global da Evolution API ---
# Deve coincidir com EVOLUTION_API_KEY no .env raiz (header `apikey` do backend)
AUTHENTICATION_API_KEY=

# --- PostgreSQL dedicado à Evolution ---
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI="postgresql://evolution:${EVOLUTION_DB_PASSWORD}@evolution-db:5432/evolution"
DATABASE_CONNECTION_CLIENT_NAME=evolution

EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=
EVOLUTION_DB_NAME=evolution

# --- Redis (compartilhado com o backend, DB 1 dedicado à Evolution) ---
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI="redis://:${REDIS_PASSWORD}@redis:6379/1"
CACHE_REDIS_PREFIX_KEY=evolution

# --- Webhook global (aponta para o backend NestJS) ---
# Criação de instância ainda passa webhook por-instância (ver prompt-motor §5.2);
# o global fica desabilitado por padrão.
WEBHOOK_GLOBAL_URL=http://backend:3000/api/v1/whatsapp/webhook
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false

# --- Logs ---
LOG_LEVEL=ERROR,WARN
LOG_COLOR=true
LOG_BAILEYS=error

# --- Manager web em :8080/manager ---
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true
